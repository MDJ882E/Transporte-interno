{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/servidor.ts",
    "build": "esbuild src/servidor.ts src/cli/migrar.ts src/cli/usuario.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --tsconfig=tsconfig.json",
    "start": "node dist/servidor.js",
    "migrar": "tsx --env-file-if-exists=../.env src/cli/migrar.ts",
    "demo": "tsx --env-file-if-exists=../.env src/cli/migrar.ts --demo",
    "usuario:crear": "tsx --env-file-if-exists=../.env src/cli/usuario.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "mssql": "^12.7.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
