# Copie este archivo como .env en el servidor y complete los valores. Nunca suba .env al repositorio.
DB_PASSWORD=cambie-esta-clave
# Genere uno con: openssl rand -hex 32
JWT_SECRET=
# Dominio del servidor. Con un dominio público, Caddy obtiene el certificado HTTPS automáticamente.
DOMINIO=transporte.ejemplo.com
