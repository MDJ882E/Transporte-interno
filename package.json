{
  "name": "transporte-interno",
  "private": true,
  "type": "module",
  "workspaces": ["api", "web"],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:migrar": "npm run migrar -w api",
    "db:demo": "npm run demo -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm test -w api && npm test -w web",
    "build": "npm run build -w api && npm run build -w web",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  },
  "engines": { "node": ">=22" }
}
