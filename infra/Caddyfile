# DOMINIO: nombre público del servidor (p. ej. transporte.empresa.com). Con un dominio público, Caddy obtiene
# el certificado HTTPS automáticamente. En una red interna sin dominio público, TI debe proveer el certificado
# (ver docs/despliegue.md). La app necesita HTTPS para instalarse y funcionar sin señal.
{$DOMINIO:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# El service worker, el manifiesto y el índice no se guardan en caché para que las actualizaciones lleguen.
		@sinCache path /sw.js /manifest.webmanifest /index.html
		header @sinCache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
}
